{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEVIN / ATLAS student fingerprint",
  "type": "object",
  "required": ["system","version","composition","accent","density","geometry","typography","motion","signature"],
  "additionalProperties": false,
  "properties": {
    "system": {"const": "LEVIN_ATLAS"},
    "version": {"type": "string", "pattern": "^1\\."},
    "composition": {"enum": ["cartographer","lab","editorial","blueprint","archive","cosmos"]},
    "accent": {"enum": ["vermilion","cobalt","forest","ochre","plum","petrol","burgundy","graphite"]},
    "density": {"enum": ["compact","balanced","airy"]},
    "geometry": {"enum": ["circular","orthogonal","mixed"]},
    "typography": {"enum": ["technical","editorial","technical-editorial"]},
    "motion": {"enum": ["calm","mechanical"]},
    "signature": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    }
  }
}