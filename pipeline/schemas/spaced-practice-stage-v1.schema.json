{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemlevin.dev/schemas/spaced-practice-stage-v1.schema.json",
  "title": "Spaced practice Stage 04 result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studentId", "lessonDate", "lessonHref", "outcomes", "gaps", "warnings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "studentId": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "lessonDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "lessonHref": {"type": "string", "minLength": 1},
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "navTitle": {"type": "string"},
        "navSubtitle": {"type": "string"},
        "summary": {"type": "string"},
        "topics": {"type": "array", "items": {"type": "string"}},
        "materials": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "practiceDisposition", "confidence", "evidence", "reason"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "practiceDisposition": {
            "enum": ["generator", "curated", "manual", "none", "coverage-gap", "competency-gap", "ambiguous"]
          },
          "competencyId": {"type": "string", "minLength": 1},
          "generatorKey": {"type": "string", "minLength": 1},
          "bankKey": {"type": "string", "minLength": 1},
          "difficulty": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 3}
          },
          "confidence": {"enum": ["exact", "high", "medium", "low", "unknown"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"},
          "level": {"type": "integer", "minimum": 0, "maximum": 4},
          "tone": {"type": "string"},
          "practiceGap": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "issue"],
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "issue": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
