{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://students-26-27.local/schemas/student-migration-manifest-v1.schema.json",
  "title": "Student Migration Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "studentId",
    "sourceArchitecture",
    "planning",
    "lessonMappings",
    "competencyMappings",
    "preserveMastery",
    "ambiguities",
    "blockers",
    "warnings"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "studentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "sourceArchitecture": {
      "enum": [
        "modern-shared",
        "legacy-ktp",
        "legacy-structured",
        "legacy-bespoke"
      ]
    },
    "planning": {
      "$ref": "#/$defs/planning"
    },
    "lessonMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lessonMapping"
      }
    },
    "competencyMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/competencyMapping"
      }
    },
    "preserveMastery": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preserveMastery"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    }
  },
  "$defs": {
    "confidence": {
      "enum": [
        "exact",
        "probable",
        "ambiguous"
      ]
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ktpExtraction"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "rolling"
          ]
        },
        "ktpExtraction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ktpExtraction"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "fixed"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "ktpExtraction": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "rolling"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "ktpExtraction": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ktpExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "preserveOrder",
        "confidence",
        "reason"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "preserveOrder": {
          "const": true
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "lessonMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonDate",
        "ktpMatches"
      ],
      "properties": {
        "lessonDate": {
          "type": "string",
          "format": "date"
        },
        "ktpMatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ktpMatch"
          }
        }
      }
    },
    "ktpMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ktpId",
        "coverage",
        "confidence",
        "reason"
      ],
      "properties": {
        "ktpId": {
          "type": "string",
          "pattern": "^ktp-[0-9]{3,}$"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "deferred"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "competencyMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonDate",
        "competencyId",
        "evidenceAnchor",
        "relation",
        "masteryClaim",
        "confidence",
        "basis"
      ],
      "properties": {
        "lessonDate": {
          "type": "string",
          "format": "date"
        },
        "competencyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "evidenceAnchor": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "relation": {
          "enum": [
            "touched",
            "practiced",
            "assessed"
          ]
        },
        "masteryClaim": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/masteryClaim"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "masteryClaim": {
                "type": "object"
              }
            },
            "required": [
              "masteryClaim"
            ]
          },
          "then": {
            "properties": {
              "relation": {
                "const": "assessed"
              },
              "confidence": {
                "const": "exact"
              }
            }
          }
        }
      ]
    },
    "masteryClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "confidence",
        "basis"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "confidence": {
          "const": "exact"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "preserveMastery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyId",
        "level",
        "sourcePath",
        "sourceKind",
        "confidence",
        "basis"
      ],
      "properties": {
        "competencyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "enum": [
            "teacher-seed",
            "teacher-mastery",
            "baseline-levels",
            "mastery-authority",
            "stage04-mastery",
            "dashboard-data"
          ]
        },
        "confidence": {
          "const": "exact"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "planning",
            "ktp",
            "lesson",
            "competency",
            "mastery",
            "source"
          ]
        },
        "lessonDate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "studentName",
        "program"
      ],
      "properties": {
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    }
  }
}
